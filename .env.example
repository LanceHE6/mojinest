# 客户端访问令牌（必填，建议 32 位随机串；空 = 不校验，仅限本机使用）
MOJINEST_TOKEN=

# 监听地址与数据目录（Docker 里保持默认即可）
MOJINEST_LISTEN=:8642
MOJINEST_DATA_DIR=/data

# 对外基础地址（生成链接用，可留空）
MOJINEST_PUBLIC_BASE_URL=

# 存储后端：local | s3
MOJINEST_STORAGE=local

# --- S3 / Cloudflare R2（MOJINEST_STORAGE=s3 时生效）---
MOJINEST_S3_ENDPOINT=
MOJINEST_S3_REGION=auto
MOJINEST_S3_BUCKET=
MOJINEST_S3_ACCESS_KEY=
MOJINEST_S3_SECRET_KEY=
# 公开访问域名（留空则走预签名 URL 代理）
MOJINEST_S3_PUBLIC_BASE=

# --- AI 自动标注（OpenAI 兼容视觉模型，留空则关闭）---
MOJINEST_TAGGER_BASE_URL=
MOJINEST_TAGGER_API_KEY=
MOJINEST_TAGGER_MODEL=qwen-vl-max
